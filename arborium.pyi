class Highlighter:
    def __init__(self, max_injection_depth: int | None = None, html_format: HtmlFormat | None = None) -> None: ...
    def highlight(self, lang: str, source: str) -> str: ...

class HtmlFormat:
    class CustomElements(HtmlFormat):
        prefix: str | None
        def __init__(self, prefix: str | None = None) -> None: ...

    class ClassNames(HtmlFormat):
        prefix: str | None
        def __init__(self, prefix: str | None = None) -> None: ...
